# Measurement rules only. No slice, lookup or model is built here.
configfile: "workflow/config.yaml"

REL = config["dataset"]["release"]
REV = config["dataset"]["revision"]
YEARS = config["years"]
assert len(YEARS) == 1, "measurement rules currently expect a single year"
YEAR = YEARS[0]

RAW = f"data/raw/BACI_{REV}_Y{YEAR}_V{REL}.csv"
TAG = f"{REV.lower()}_{YEAR}"

rule measure_all:
    input:
        f"data/intermediate/candidate_measurements_{TAG}.csv",
        f"data/intermediate/candidate_special_codes_{TAG}.csv",

rule measure_candidates:
    input:
        raw=RAW,
    output:
        measurements=f"data/intermediate/candidate_measurements_{TAG}.csv",
        flows=f"data/intermediate/candidate_flows_{TAG}.csv",
    log:
        "workflow/logs/measure_candidates.log",
    script:
        "scripts/measure_candidates.py"

rule special_codes:
    input:
        flows=f"data/intermediate/candidate_flows_{TAG}.csv",
        countries=f"data/raw/country_codes_V{REL}.csv",
    output:
        special=f"data/intermediate/candidate_special_codes_{TAG}.csv",
        classification=f"data/intermediate/country_code_classification_{TAG}.csv",
    log:
        "workflow/logs/special_codes.log",
    script:
        "scripts/special_codes.py"
