@prefix : <https://w3id.org/FAIR-course-UT/2026/group13/ont#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/FAIR-course-UT/2026/group13/ont#> .

<https://w3id.org/FAIR-course-UT/2026/group13/ont> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group13/ont#exporterArea
:exporterArea rdf:type owl:ObjectProperty ;
              rdfs:domain :TradeFlow ;
              rdfs:range :TradePartnerArea ;
              rdfs:comment "The trade-partner area that exported the product in this trade flow." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#importerArea
:importerArea rdf:type owl:ObjectProperty ;
              rdfs:domain :TradeFlow ;
              rdfs:range :TradePartnerArea ;
              rdfs:comment "The trade-partner area that imported the product in this trade flow." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#product
:product rdf:type owl:ObjectProperty ;
         rdfs:domain :TradeFlow ;
         rdfs:comment "The HS6-coded product traded in this trade flow." .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group13/ont#isoAlpha3
:isoAlpha3 rdf:type owl:DatatypeProperty ;
           rdfs:domain :TradePartnerArea ;
           rdfs:range xsd:string ;
           rdfs:comment "The ISO 3166-1 alpha-3 code for this trade-partner area, where applicable." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#quantity
:quantity rdf:type owl:DatatypeProperty ;
          rdfs:domain :TradeFlow ;
          rdfs:range xsd:decimal ;
          rdfs:comment "The traded quantity of the product, in metric tons, when reported." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#value
:value rdf:type owl:DatatypeProperty ;
       rdfs:domain :TradeFlow ;
       rdfs:range xsd:decimal ;
       rdfs:comment "The trade value of this flow, in thousands of current USD, as reported by CEPII." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#valueComment
:valueComment rdf:type owl:DatatypeProperty ;
              rdfs:domain :TradeFlow ;
              rdfs:range rdf:langString ;
              rdfs:comment "A human-readable note stating the unit and scale of the value property." .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#year
:year rdf:type owl:DatatypeProperty ;
      rdfs:domain :TradeFlow ;
      rdfs:range xsd:gYear ;
      rdfs:comment "The calendar year in which the trade flow was recorded." .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group13/ont#TradeFlow
:TradeFlow rdf:type owl:Class .


###  https://w3id.org/FAIR-course-UT/2026/group13/ont#TradePartnerArea
:TradePartnerArea rdf:type owl:Class .


